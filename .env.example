# Copy this file to .env and fill in your own values.
# NEVER commit .env or paste these keys into frontend code.

# Free key from https://aistudio.google.com/apikey  (leave empty = rules-only mode)
GEMINI_API_KEY=

# Model name. "gemini-flash-latest" always points to Google's current Flash model.
# You can pin a specific model from the AI Studio model list instead.
GEMINI_MODEL=gemini-flash-latest

# From @BotFather on Telegram (only needed for bot.py)
TELEGRAM_BOT_TOKEN=

# Where the bot keeps chat IDs, family links and language preference
FAMILY_DB_PATH=family.db

# Which website origins may call the API. "*" is fine for the demo.
# For a real launch put your frontend's address, e.g. https://doublecheck.example.com
ALLOWED_ORIGINS=*
